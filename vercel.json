{
 "headers": [
  {
   "source": "/(admin|command.html)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    },
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  },
  {
   "source": "/games/(.*)/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800, stale-while-revalidate=86400"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/admin",
   "destination": "/command.html"
  }
 ]
}